# Flask Configuration
SECRET_KEY=your-secret-key-here-change-this-in-production
FLASK_DEBUG=True

# Database Configuration (SQLite for local development)
DATABASE_URL=sqlite:///heart_disease.db

# Mail Configuration (optional - for password reset functionality)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# Gemini API Configuration (optional - for advanced chatbot features)
GEMINI_API_KEY=your-gemini-api-key-here

# MongoDB Configuration (optional - for future use)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/heart_disease_db

# Initial admin account (set before first launch)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
